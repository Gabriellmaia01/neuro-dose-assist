{
    "rules": {
        "users": {
            "$userId": {
                "clinic": {
                    ".read": "auth != null && ($userId === auth.uid || data.child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && $userId === auth.uid"
                },
                "clinicInvites": {
                    ".read": "auth != null && $userId === auth.uid",
                    ".write": "auth != null && $userId === auth.uid",
                    "$inviteId": {
                        ".read": "auth != null && ($userId === auth.uid || data.child('email').val() === auth.token.email)"
                    }
                },
                "clinicMembership": {
                    ".read": "auth != null && $userId === auth.uid",
                    ".write": "auth != null && $userId === auth.uid"
                },
                "activityLogs": {
                    ".read": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())"
                },
                "patients": {
                    ".read": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())"
                },
                "medications": {
                    ".read": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())"
                },
                "doses": {
                    ".read": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())"
                },
                "notes": {
                    ".read": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())",
                    ".write": "auth != null && ($userId === auth.uid || root.child('users').child($userId).child('clinic').child('memberUids').child(auth.uid).exists())"
                }
            }
        }
    }
}
