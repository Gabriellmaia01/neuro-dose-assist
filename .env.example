# Provedor de banco de dados dos módulos clínicos ("spring" para API Spring Boot + MongoDB Atlas | "firebase" para legado)
VITE_API_PROVIDER=spring
VITE_API_BASE_URL=/api/v1

# Firebase Authentication (mantido exclusivamente para Login / Google / Recuperação de senha)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# Variáveis do Backend Spring Boot (configure no ambiente ou em backend/src/main/resources/application-local.yml)
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.po3lzn7.mongodb.net/neurodose?retryWrites=true&w=majority&appName=Cluster0
# MONGODB_DATABASE=neurodose
# FIREBASE_PROJECT_ID=
